# ====================================================================
# Hearth — Environment Variables & Free LLM APIs Configuration
# Integrated with awesome-freellm-apis (Free tier, no credit card required)
# Created by Aarush Gupta
# ====================================================================

# 1. Google Gemini (Primary free tier: 15 RPM / 1500 RPD)
# Get free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."

# 2. Groq Cloud (Ultra-fast LPU: 30 RPM / 14400 RPD)
# Default model: llama-3.3-70b-versatile
# Get free key: https://console.groq.com/keys
# GROQ_API_KEY="gsk_..."
# GROQ_MODEL="llama-3.3-70b-versatile"

# 3. Cerebras Cloud (Wafer-scale speed: 30 RPM / 1M tokens/day)
# Default model: llama3.3-70b
# Get free key: https://cloud.cerebras.ai
# CEREBRAS_API_KEY="csk-..."
# CEREBRAS_MODEL="llama3.3-70b"

# 4. SambaNova Cloud (Full 70B / 72B parameter precision: 20 RPM)
# Default model: Meta-Llama-3.3-70B-Instruct
# Get free key: https://cloud.sambanova.ai
# SAMBANOVA_API_KEY="..."
# SAMBANOVA_MODEL="Meta-Llama-3.3-70B-Instruct"

# 5. OpenRouter Free Models (DeepSeek-R1, Llama 3.3, Gemini 2.0 Free)
# Default model: deepseek/deepseek-r1:free
# Get free key: https://openrouter.ai/keys
# OPENROUTER_API_KEY="sk-or-v1-..."
# OPENROUTER_MODEL="deepseek/deepseek-r1:free"

# 6. Mistral AI (Free experimental tier: 60 RPM)
# Default model: mistral-small-latest
# Get free key: https://console.mistral.ai
# MISTRAL_API_KEY="..."
# MISTRAL_MODEL="mistral-small-latest"

# 7. GitHub Models (Free with personal GitHub account token: 15 RPM)
# Default model: gpt-4o-mini
# Get token: https://github.com/settings/tokens
# GITHUB_TOKEN="ghp_..."
# GITHUB_MODEL="gpt-4o-mini"

# 8. Additional Generic Key Pool Slots (Failover slots 1..20)
# AI_API_KEY_1="..."
# AI_API_KEY_2="..."
# AI_API_KEY_3="..."

# 9. Global Defaults
AI_PROVIDER="gemini"
AI_MODEL="gemini-3.8-flash"

# 10. Owner & Administration
OWNER_EMAIL="aarush5732@gmail.com"
OWNER_SECRET="change-me-to-a-secure-random-secret"

# 11. App Hosting
APP_URL="https://your-hearth-app.vercel.app"

# 12. Optional Cloud Operational Database (Vercel Postgres / Neon)
# If omitted, Hearth uses its local persistent ACID operational store.
# POSTGRES_URL="postgres://..."
